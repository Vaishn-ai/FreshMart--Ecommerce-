SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite only — this becomes backend/db.sqlite3
DB_NAME=db.sqlite3

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=https://freshmart-ecommerce-pied.vercel.app, https://freshmart-ecommerce-pied.vercel.app

# Used to build product/page URLs in the sitemap — set to your real public
# domain in production (the one domain nginx serves both frontend + backend under)
FRONTEND_URL=https://freshmart-ecommerce-pied.vercel.app

USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Phase 3+ (payments) — placeholders for now
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- HTTPS: leave all three False for local HTTP-only dev. Only set True once ---
# --- the app is actually served over HTTPS (e.g. behind the nginx TLS proxy).  ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
